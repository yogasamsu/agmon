# Jaringan Monad. Cek ulang nilainya di https://docs.monad.xyz sebelum deploy.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143

# Diisi setelah deploy contract (lihat README)
FIREBOND_ADDRESS=

# Dompet terpisah per peran. JANGAN pakai dompet yang berisi aset sungguhan.
ORACLE_PRIVATE_KEY=
OWNER_PRIVATE_KEY=

# Supabase (Cloud atau self-hosted). Oracle memakai service_role key (bisa menulis).
# Kunci ini rahasia: hanya untuk oracle, jangan dipasang di Vercel.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# NASA FIRMS: daftar MAP_KEY gratis di https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,VIIRS_SNPP_NRT
# barat,selatan,timur,utara; beberapa kotak dipisah titik koma (bawaan: seluruh Indonesia)
FIRMS_AREAS=94.5,-11.5,141.5,6.5
FIRMS_DAY_RANGE=2

# Jaminan awal per konsesi saat seed, dalam MON
BOND_MON=10
# Batas laporan on-chain per putaran oracle
MAX_REPORTS=25
