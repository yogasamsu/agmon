# Dibaca di server saja (tidak terkirim ke browser).
# Pakai anon key Supabase. Anon key hanya bisa membaca karena dibatasi RLS.
# JANGAN isi service role key di sini atau di Vercel.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# Terlihat di browser.
NEXT_PUBLIC_FIREBOND_ADDRESS=
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadexplorer.com
NEXT_PUBLIC_REPO_URL=https://github.com/yogasamsu/agmon
